# Copy these variable names into Vercel or your host. Do NOT commit a filled-in copy.
# A local copy may be named .env.production.local (already git-ignored).

DATA_DRIVER=supabase
NEXT_PUBLIC_DATA_DRIVER=supabase

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# The email you register first and promote to owner
OWNER_EMAIL=you@example.com

# Your live studio URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Generate on your own device: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
