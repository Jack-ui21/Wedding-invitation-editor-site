# Copy to .env.local and fill in. NEVER commit .env.local.

# Production (Supabase). Leave unset to use the LOCAL development driver.
# The LOCAL driver stores data server-side in .data/ and is disabled in production builds.
DATA_DRIVER=local
# Must match DATA_DRIVER. Exposed to the browser only to choose the upload strategy.
NEXT_PUBLIC_DATA_DRIVER=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Owner account. Register/sign in with this email first, then promote it via
# supabase/migrations/0002_owner_helpers.sql or `npm run promote-owner`.
OWNER_EMAIL=owner@example.com

# Public base URL used for published invitation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the httpOnly session cookie. REQUIRED in production (32+ random characters).
# Generate with: openssl rand -hex 32
SESSION_SECRET=local-development-only-change-me-please-replace
