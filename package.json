{
  "name": "wedding-invitation-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 3000",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run --environment jsdom",
    "test:watch": "node node_modules/vitest/vitest.mjs --environment jsdom",
    "seed-owner": "node --import tsx scripts/seed-owner.ts",
    "seed-templates": "node --import tsx scripts/seed-templates.ts",
    "promote-owner": "node --import tsx scripts/promote-owner.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "jsdom": "27.3.0",
    "jszip": "3.10.2",
    "lucide-react": "0.577.0",
    "monaco-editor": "0.58.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
